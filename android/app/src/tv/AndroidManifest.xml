<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.gamepad"
        android:required="false" />

    <application android:label="Kazumi TV" android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher" tools:replace="android:icon,android:label">
        <!-- A TV remote needs DOWN/UP timing for short/long BACK. Android 16
             predictive back consumes KEYCODE_BACK before Activity dispatch.
             Only the TV flavor opts out; mobile gesture navigation is unchanged. -->
        <activity android:name=".MainActivity"
            android:enableOnBackInvokedCallback="false">
            <!-- Some vendor TV app drawers query LAUNCHER, not LEANBACK.
                 Both entries resolve to the same TV activity and package. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
